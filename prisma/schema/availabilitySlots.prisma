model AvailabilitySlots {
  id String @id @default(uuid())

  dayOfWeek DayOfWeek
  startTime String
  endTime String

  technicianId String
  technician TechnicianProfile @relation(fields: [technicianId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([technicianId, dayOfWeek])
  @@index([technicianId])
  @@map("availabilitySlots")
}